# ==========================================================
# KIOSK DASHBOARD
# Raspberry Pi 5 / Debian Trixie
#
# SYSTEM RUNNING
#       │
#       ▼
# kiosk.service
#       │
#       ▼
#     tty3
#       │
#   Dashboard
#       │
#   ┌───┴───────────────┐
#   │                   │
# normalny          reboot / shutdown
#   exit                 │
#   │                    │
#   └────────┬───────────┘
#            ▼
#     zatrzymanie kiosk
#            │
#            ▼
#        cleanup TTY
#            │
#            ▼
#          chvt 1
#            │
#            ▼
#          tty1
# ==========================================================
[Unit]
Description=kiosk system monitor


# ==========================================================
# KOLEJNOŚĆ STARTU
# ==========================================================

After=systemd-user-sessions.service getty@tty3.service

# kiosk przejmuje tty3 od getty.
Conflicts=getty@tty3.service


# ==========================================================
# SERVICE
# ==========================================================

[Service]

Type=simple


# ==========================================================
# UŻYTKOWNIK
# ==========================================================

User=markiel


# ==========================================================
# KATALOG PROGRAMU
# ==========================================================

WorkingDirectory=/home/markiel/kiosk


# ==========================================================
# TTY3
# ==========================================================

TTYPath=/dev/tty3

StandardInput=tty
StandardOutput=tty
StandardError=journal


# ==========================================================
# RESET TTY
# ==========================================================

TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes


# ==========================================================
# UPRAWNIENIE DO PRZEŁĄCZANIA VT
# ==========================================================

AmbientCapabilities=CAP_SYS_TTY_CONFIG
CapabilityBoundingSet=CAP_SYS_TTY_CONFIG


# ==========================================================
# ŚRODOWISKO
# ==========================================================

Environment=TERM=linux
Environment=PYTHONUNBUFFERED=1

# ==========================================================
# START NA TTY3
# ==========================================================

# Po uruchomieniu usługi aktywujemy tty3.
#
# Dzięki temu:
#
# systemctl start kiosk
#
# oraz:
#
# systemctl restart kiosk
#
# zawsze kończą się na tty3.

ExecStartPre=/usr/bin/chvt 3


# ==========================================================
# CZCIONKA KONSOLI
# ==========================================================

# W przyszłości:
#
# ExecStartPre=/usr/bin/setfont /usr/share/consolefonts/NAZWA.psf.gz


# ==========================================================
# URUCHOMIENIE DASHBOARDU
# ==========================================================

ExecStart=/usr/bin/python3 /home/markiel/kiosk/dashboard.py


# ==========================================================
# ZACHOWANIE PO AWARII
# ==========================================================

Restart=always
RestartSec=2


# ==========================================================
# POWRÓT DO TTY1
# ==========================================================

# Po zakończeniu usługi przechodzimy na tty1.
#
# Dotyczy:
#
# - systemctl stop kiosk
# - restart kiosk
# - reboot
# - shutdown
# - normalnego zakończenia programu

ExecStopPost=/usr/bin/chvt 1


# ==========================================================
# INSTALL
# ==========================================================

[Install]

WantedBy=multi-user.target
